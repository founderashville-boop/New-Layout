files["src/App.jsx"] = r'''import React, { useMemo, useState } from "react";
import {
  Search, Menu, X, ChevronRight, Star, Download, Heart, Plus,
  LayoutDashboard, Package, Settings, Shield, LogIn, Gamepad2,
  Car, Music, Video, Building2, GraduationCap, Code2, Users,
  ArrowRight, CheckCircle2, Sparkles
