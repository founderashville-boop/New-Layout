const categories = [
  ["Gaming", Gamepad2], ["Roleplay", Car], ["Music", Music], ["Creators", Video],
  ["Business", Building2], ["Education", GraduationCap], ["Development", Code2], ["Community", Users]
];

const templates = [
  {id:1,name:"Oakwood State Roleplay",category:"Roleplay",description:"A complete professional Roblox roleplay Discord server structure.",rating:4.9,downloads:2431,channels:87,roles:42,color:"blue"},
  {id:2,name:"SRU_UnstoppableTV",category:"Creators",description:"A complete community server for gaming creators, livestreamers, and fans.",rating:4.8,downloads:1824,channels:63,roles:29,color:"purple"},
  {id:3,name:"PDS Community",category:"Community",description:"Official-style community Discord structure for gaming development groups.",rating:5,downloads:3156,channels:72,roles:35,color:"cyan"},
  {id:4,name:"Gaming Central",category:"Gaming",description:"Modern gaming community layout with support, announcements, and events.",rating:4.7,downloads:1462,channels:55,roles:24,color:"green"},
  {id:5,name:"Music Network",category:"Music",description:"Community layout for artists, producers, DJs, and music communities.",rating:4.8,downloads:982,channels:48,roles:21,color:"pink"},
  {id:6,name:"Developer Hub",category:"Development",description:"Organized Discord server for developers, projects, support, and collaboration.",rating:4.9,downloads:1238,channels:61,roles:27,color:"orange"}
];

export default function App() {
  const [page,setPage]=useState("home"), [menu,setMenu]=useState(false), [search,setSearch]=useState("");
  const [category,setCategory]=useState("All"), [selected,setSelected]=useState(null);
  const [favorites,setFavorites]=useState([]), [modal,setModal]=useState(null);

  const filtered=useMemo(()=>templates.filter(t=>
    (category==="All"||t.category===category) &&
    (t.name+" "+t.description).toLowerCase().includes(search.toLowerCase())
  ),[category,search]);

  const go=(p,c="All")=>{setCategory(c);setPage(p);setMenu(false);window.scrollTo(0,0)};
  const open=(t)=>{setSelected(t);setPage("template");window.scrollTo(0,0)};
  const fav=(id)=>setFavorites(v=>v.includes(id)?v.filter(x=>x!==id):[...v,id]);

  function discordLogin(){
    const clientId=import.meta.env.VITE_DISCORD_CLIENT_ID;
    const redirect=import.meta.env.VITE_DISCORD_REDIRECT_URI||`${location.origin}/api/discord/callback`;
    if(!clientId){setModal("login");return}
    const q=new URLSearchParams({client_id:clientId,redirect_uri:redirect,response_type:"code",scope:"identify"});
    location.href=`https://discord.com/oauth2/authorize?${q}`;
  }

  return <div className="app">
    <nav className="nav">
      <div className="brand" onClick={()=>go("home")}><b>PDS</b><span><strong>Prime District Studios™</strong><small>PDS Templates™</small></span></div>
      <div className="links">
        <button onClick={()=>go("home")}>Home</button><button onClick={()=>go("templates")}>Templates</button>
        <button onClick={()=>go("templates")}>Categories</button><button onClick={()=>go("dashboard")}>Dashboard</button>
      </div>
      <button className="login" onClick={discordLogin}><LogIn size={17}/> Login with Discord</button>
      <button className="hamb" onClick={()=>setMenu(!menu)}>{menu?<X/>:<Menu/>}</button>
    </nav>
    {menu&&<div className="mobileLinks"><button onClick={()=>go("home")}>Home</button><button onClick={()=>go("templates")}>Templates</button><button onClick={()=>go("dashboard")}>Dashboard</button><button onClick={discordLogin}>Login with Discord</button></div>}

    {page==="home"&&<Home search={search} setSearch={setSearch} go={go} setModal={setModal} open={open} fav={fav} favorites={favorites}/>}
    {page==="templates"&&<Templates search={search} setSearch={setSearch} category={category} setCategory={setCategory} filtered={filtered} open={open} fav={fav} favorites={favorites}/>}
    {page==="template"&&selected&&<Details t={selected} favorite={favorites.includes(selected.id)} fav={fav} back={()=>go("templates")}/>}
    {page==="dashboard"&&<Dashboard favorites={favorites} setModal={setModal} open={open}/>}
    {page==="admin"&&<Admin/>}

    <footer><div className="footerTop"><div className="brand"><b>PDS</b><span><strong>Prime District Studios™</strong><small>Building Worlds. Creating Experiences.</small></span></div><div className="footCols"><div><strong>Platform</strong><button onClick={()=>go("home")}>Home</button><button onClick={()=>go("templates")}>Templates</button><button onClick={()=>go("dashboard")}>Dashboard</button></div><div><strong>Community</strong><button>Discord</button><button>Support</button><button onClick={()=>setModal("submit")}>Submit Template</button></div><div><strong>Legal</strong><button>Privacy</button><button>Terms</button><button>Guidelines</button></div></div></div><div className="footBottom">© 2026 Prime District Studios™. All rights reserved.<span>PDS Templates™</span></div></footer>

    {modal==="login"&&<Modal close={()=>setModal(null)}><div className="modalLogo">PDS</div><h2>Welcome to PDS Templates™</h2><p>Sign in with Discord to save templates, submit templates, and manage your account.</p><button className="discord" onClick={discordLogin}><LogIn size={18}/> Continue with Discord</button><small>Secure Discord OAuth2 authentication.</small></Modal>}
    {modal==="submit"&&<Submit close={()=>setModal(null)}/>}
  </div>
}

function Home({search,setSearch,go,setModal,open,fav,favorites}){
  return <main><section className="hero"><div className="heroContent"><div className="eyebrow"><Sparkles size={15}/> POWERED BY PRIME DISTRICT STUDIOS™</div><h1>Build Your Discord.<br/><em>Your Way.</em></h1><p>Discover professionally designed Discord server templates for communities, gaming, roleplay, creators, businesses, and more.</p><div className="heroSearch"><Search/><input value={search} onChange={e=>setSearch(e.target.value)} onKeyDown={e=>e.key==="Enter"&&go("templates")} placeholder="Search Discord templates..."/><button onClick={()=>go("templates")}>Search</button></div><div className="actions"><button className="primary" onClick={()=>go("templates")}>Explore Templates <ArrowRight size={17}/></button><button className="secondary" onClick={()=>setModal("submit")}><Plus size={17}/> Submit Template</button></div></div></section>
  <section className="section"><Head title="Browse Categories" text="Find the perfect structure for your community."/><div className="catGrid">{categories.map(([n,I])=><button className="cat" key={n} onClick={()=>go("templates",n)}><i><I size={22}/></i><span>{n}</span><ChevronRight size={16}/></button>)}</div></section>
  <section className="section"><Head title="Featured Templates" text="Templates selected by the PDS community." action="View All" onAction={()=>go("templates")}/><div className="grid">{templates.slice(0,3).map(t=><Card key={t.id} t={t} open={open} fav={fav} favorite={favorites.includes(t.id)}/>)}</div></section>
  <section className="cta"><div><div className="eyebrow">✓ BUILT FOR COMMUNITIES</div><h2>Have a Discord template to share?</h2><p>Publish your server structure and let the PDS community discover it.</p></div><button className="primary" onClick={()=>setModal("submit")}>Submit Your Template <ArrowRight size={17}/></button></section></main>
}

function Templates({search,setSearch,category,setCategory,filtered,open,fav,favorites}){
  return <main className="container"><div className="pageHead"><div><div className="eyebrow">PDS TEMPLATE LIBRARY</div><h1>Discord Templates</h1><p>Discover server structures created by the community.</p></div><div className="libSearch"><Search size={18}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search templates..."/></div></div><div className="filters"><button className={category==="All"?"sel":""} onClick={()=>setCategory("All")}>All</button>{categories.map(([n])=><button key={n} className={category===n?"sel":""} onClick={()=>setCategory(n)}>{n}</button>)}</div>{filtered.length?<div className="grid">{filtered.map(t=><Card key={t.id} t={t} open={open} fav={fav} favorite={favorites.includes(t.id)}/>)}</div>:<div className="empty"><Search size={40}/><h2>No templates found</h2><p>Try another search or category.</p></div>}</main>
}

function Card({t,open,fav,favorite}){return <article className="card"><div className={`preview ${t.color}`}><DiscordPreview/><button className={`heart ${favorite?"liked":""}`} onClick={e=>{e.stopPropagation();fav(t.id)}}><Heart size={18} fill={favorite?"currentColor":"none"}/></button></div><div className="cardBody"><label>{t.category}</label><h3>{t.name}</h3><p>{t.description}</p><div className="meta"><span><Star size={14} fill="currentColor"/> {t.rating}</span><span><Download size={14}/> {t.downloads.toLocaleString()}</span></div><button className="view" onClick={()=>open(t)}>View Template <ChevronRight size={16}/></button></div></article>}

function DiscordPreview(){return <div className="discordPrev"><aside><b>PDS</b><i></i><i></i><i></i></aside><div className="channels"><small>INFORMATION</small><span># welcome</span><span># announcements</span><span># general</span><small>COMMUNITY</small><span># media</span><span># suggestions</span></div></div>}

function Details({t,favorite,fav,back}){return <main className="container"><button className="back" onClick={back}>← Back to Templates</button><div className="detail"><div className={`detailPreview ${t.color}`}><DiscordPreview/></div><div><label>{t.category}</label><h1>{t.name}</h1><p>{t.description}</p><div className="rating"><Star size={18} fill="currentColor"/> <b>{t.rating}</b> · {t.downloads.toLocaleString()} downloads</div><div className="actions"><button className="primary" onClick={()=>alert("Connect your Discord server-install backend to enable one-click installation.")}><Download size={17}/> Use Template</button><button className="secondary" onClick={()=>fav(t.id)}><Heart size={17} fill={favorite?"currentColor":"none"}/> {favorite?"Saved":"Favorite"}</button></div></div></div><div className="detailGrid"><section className="panel"><h2>Server Structure</h2>{[["📢 INFORMATION",["welcome","rules","announcements","server-information"]],["💬 COMMUNITY",["general","media","suggestions","support"]],["🚓 DEPARTMENTS",["law-enforcement","fire-ems","department-info"]],["🛡️ STAFF",["staff-chat","reports","staff-announcements"]]].map(([n,c])=><div className="structure" key={n}><strong>{n}</strong>{c.map(x=><span key={x}># {x}</span>)}</div>)}</section><section className="panel"><h2>Template Information</h2>{[["Created by",t.creator||"Prime District Studios™"],["Category",t.category],["Channels",t.channels],["Roles",t.roles],["Downloads",t.downloads.toLocaleString()]].map(([a,b])=><div className="info" key={a}><span>{a}</span><b>{b}</b></div>)}</section></div></main>}

function Dashboard({favorites,setModal,open}){let favs=templates.filter(t=>favorites.includes(t.id));return <main className="container"><div className="dashboard"><aside className="side"><div className="user"><b>P</b><span><strong>PDS User</strong><small>Community Member</small></span></div><button className="active"><LayoutDashboard/> Overview</button><button><Package/> My Templates</button><button><Heart/> Favorites</button><button onClick={()=>setModal("submit")}><Plus/> Submit Template</button><button><Settings/> Settings</button></aside><section><div className="pageHead"><div><div className="eyebrow">DASHBOARD</div><h1>Welcome back.</h1><p>Manage your PDS Templates account.</p></div></div><div className="stats">{[["Templates","12",Package],["Downloads","8,421",Download],["Favorites",favorites.length,Heart],["Rating","4.9",Star]].map(([a,b,I])=><div className="stat" key={a}><I/><span>{a}<b>{b}</b></span></div>)}</div><Head title="Your Favorites" text="Templates you have saved."/><div className="grid">{favs.length?favs.map(t=><Card key={t.id} t={t} open={open} fav={()=>{}} favorite/>):<div className="empty"><Heart size={32}/><h3>No favorites yet</h3></div>}</div></section></div></main>}

function Admin(){return <main className="container"><div className="pageHead"><div><div className="eyebrow">PDS ADMINISTRATION</div><h1>Admin Center</h1><p>Manage templates, users, moderation, and platform settings.</p></div></div><div className="stats">{[["Templates","1,284",Package],["Users","8,492",Users],["Downloads","42,891",Download],["Pending Reviews","17",Shield]].map(([a,b,I])=><div className="stat" key={a}><I/><span>{a}<b>{b}</b></span></div>)}</div><div className="adminGrid">{[["Templates",Package],["Users",Users],["Moderation",Shield],["Settings",Settings]].map(([x,I])=><button className="adminCard" key={x}><I/><span><b>{x}</b><small>Manage PDS {x.toLowerCase()}.</small></span><ChevronRight/></button>)}</div></main>}

function Head({title,text,action,onAction}){return <div className="sectionHead"><div><h2>{title}</h2><p>{text}</p></div>{action&&<button onClick={onAction}>{action} <ArrowRight size={16}/></button>}</div>}

function Modal({close,children}){return <div className="overlay" onClick={close}><div className="modal" onClick={e=>e.stopPropagation()}><button className="close" onClick={close}><X/></button>{children}</div></div>}

function Submit({close}){const [done,setDone]=useState(false);return <Modal close={close}>{done?<div className="success"><CheckCircle2 size={50}/><h2>Submitted!</h2><p>Your template has been submitted for PDS review.</p><button className="primary" onClick={close}>Done</button></div>:<><div className="modalLogo">PDS</div><h2>Submit a Template</h2><p>Share your Discord server structure with the PDS community.</p><form onSubmit={e=>{e.preventDefault();setDone(true)}}><label>Template Name<input required placeholder="My Discord Server"/></label><label>Category<select required defaultValue=""><option value="" disabled>Select category</option>{categories.map(([n])=><option key={n}>{n}</option>)}</select></label><label>Description<textarea required rows="4" placeholder="Describe your template..."/></label><button className="primary full">Submit for Review</button></form></>}</Modal>}

function AppUnused(){return null}
'''

